{
  "name": "timestamp-tool",
  "developer": "timestamp-developer",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "version": "1.0.0",
  "pluginSetting": {
    "height": 560
  },
  "features": [
    {
      "code": "timestamp-tool",
      "explain": "Timestamp converter with second and millisecond modes, timezone support, and bilingual interface",
      "cmds": ["时间戳", "时间戳转换", "timestamp", "ts"]
    },
    {
      "code": "timestamp-regex",
      "explain": "Convert between timestamps and dates",
      "cmds": [
        {
          "type": "regex",
          "label": "秒级时间戳转日期",
          "match": "/^\\d{10}$/",
          "minLength": 10,
          "maxLength": 10
        },
        {
          "type": "regex",
          "label": "毫秒时间戳转日期",
          "match": "/^\\d{13}$/",
          "minLength": 13,
          "maxLength": 13
        },
        {
          "type": "regex",
          "label": "微秒时间戳转日期",
          "match": "/^\\d{16}$/",
          "minLength": 16,
          "maxLength": 16
        },
        {
          "type": "regex",
          "label": "纳秒时间戳转日期",
          "match": "/^\\d{19}$/",
          "minLength": 19,
          "maxLength": 19
        },
        {
          "type": "regex",
          "label": "日期格式识别",
          "match": "/^\\d{4}[-/.]?\\d{1,2}[-/.]?\\d{1,2}$/",
          "minLength": 8,
          "maxLength": 10
        },
        {
          "type": "regex",
          "label": "日期时间格式识别（含毫秒/微秒/纳秒/时区）",
          "match": "/^\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}[T ]\\d{1,2}:\\d{1,2}(:\\d{1,2}(\\.\\d{1,9})?)?(Z|[+-]\\d{2}:?\\d{2})?$/",
          "minLength": 13,
          "maxLength": 35
        }
      ]
    }
  ]
}