{
  "name": "timestamp-web-electron",
  "version": "1.0.0",
  "description": "Timestamp converter desktop shell (Electron) reusing the uTools plugin frontend",
  "author": "timestamp-developer",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node ../scripts/build-standalone.mjs && electron .",
    "pack:win": "node ../scripts/build-standalone.mjs && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.timestamp.converter",
    "productName": "Timestamp Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../build",
        "to": "webui"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "时间戳转换器",
      "installerLanguages": ["zh_CN", "en_US"],
      "artifactName": "timestamp-converter-setup-${version}.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}